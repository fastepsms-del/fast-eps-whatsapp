# ============================================================================
# Fast EPS · Atendimento WhatsApp com IA — variáveis de ambiente
# Copie este arquivo para ".env" (local) ou configure as mesmas chaves no
# painel do provedor de hospedagem (ex: Vercel > Project Settings > Environment
# Variables). NUNCA faça commit do arquivo ".env" com valores reais.
# ============================================================================

# --- Banco de dados -----------------------------------------------------
# String de conexão PostgreSQL. Pode usar Neon, Supabase, Railway, RDS, etc.
DATABASE_URL="postgresql://user:password@host:5432/fast_eps?schema=public"

# --- Meta WhatsApp Cloud API ---------------------------------------------
# Criada em https://developers.facebook.com/apps -> seu app -> WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID="000000000000000"
WHATSAPP_BUSINESS_ACCOUNT_ID="000000000000000"
# Token permanente do System User (Meta Business Suite > System Users)
WHATSAPP_ACCESS_TOKEN="EAAG..."
# Token que você escolhe e cadastra na verificação do Webhook (Meta App > Webhooks)
WHATSAPP_VERIFY_TOKEN="escolha-um-token-secreto-aqui"
# App Secret do app da Meta, usado para validar a assinatura HMAC dos webhooks
WHATSAPP_APP_SECRET="segredo-do-app-meta"
# Versão da Graph API utilizada
WHATSAPP_GRAPH_API_VERSION="v20.0"

# --- IA (Anthropic / Claude) ---------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Painel administrativo -------------------------------------------------
# Usuário e senha do painel /admin (autenticação simples por cookie assinado).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="troque-esta-senha"
# Segredo usado para assinar o cookie de sessão do admin (gere um valor aleatório longo)
ADMIN_SESSION_SECRET="gere-uma-string-aleatoria-bem-longa-aqui"

# --- Cron / Follow-up -------------------------------------------------------
# Segredo enviado pelo Vercel Cron (ou outro agendador) no header Authorization
# para autorizar a chamada em /api/cron/followups
CRON_SECRET="outro-segredo-aleatorio-para-o-cron"

# --- Fuso horário / horário comercial ---------------------------------------
BUSINESS_TIMEZONE="America/Sao_Paulo"
BUSINESS_HOURS_START="7"
BUSINESS_HOURS_END="18"
